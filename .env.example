# ── Admin panel security (REQUIRED in production) ──────────────────
# Generate both lines with: node scripts/hash-password.mjs "your-strong-password"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Dev-only fallback (ignored when ADMIN_PASSWORD_HASH is set):
# ADMIN_PASSWORD=tripwaley@2026

# ── Integrations ───────────────────────────────────────────────────
# n8n webhook that receives every seat-hold lead (→ Twenty CRM)
N8N_WEBHOOK_URL=

# Booking webhook — receives every seat-hold lead AND every completed payment
TW_BOOKING_WEBHOOK=

# Absolute public origin, used to build the URL PhonePe redirects back to.
# Falls back to the request Host header; set it explicitly behind a CDN.
NEXT_PUBLIC_SITE_URL=https://tripwaley.com

# ── PhonePe payment gateway (Standard Checkout V2 / OAuth) ─────────
# From PhonePe Business → Developer Settings → API Keys.
#
# OPTIONAL. These can also be set from Admin → Payments without a redeploy,
# which is the easier path for sandbox testing. Anything set HERE WINS over
# the admin panel — so production keys in Dokploy can never be silently
# overridden by a stale sandbox key left in the panel.
#
# Leave everything blank and unset in the panel to switch payments off: with
# no credentials the site renders no Pay button at all, rather than one that
# fails on click.
#
# NOTE these are the V2 OAuth keys (client id/secret/version) — NOT the older
# merchantId + saltKey pair. Different endpoints, different auth.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# sandbox = PhonePe's test environment (no real money moves)
# production = live. Switch only after a successful sandbox payment.
PHONEPE_ENV=sandbox

# Credentials you invent yourself and enter on PhonePe Business →
# Developer Settings → Webhooks, alongside the callback URL:
#   https://www.tripwaley.com/api/pay/webhook
# PhonePe signs each callback as SHA256(username:password); a callback that
# doesn't match is discarded. Without these, every callback is rejected.
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASS=
